# Copy this to .env.local for local development
# Add these same values in Vercel dashboard → Settings → Environment Variables

# The Odds API key (for live sportsbook moneylines)
# Get yours at: https://the-odds-api.com
ODDS_API_KEY=your-odds-api-key-here

# Deployed Vercel URL, no protocol (used by .github/workflows/daily-picks.yml
# to call the /api/best-bets endpoint), e.g. best-bets.vercel.app
VERCEL_URL=your-project.vercel.app
