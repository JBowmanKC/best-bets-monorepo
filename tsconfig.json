{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "declaration":      true,
    "outDir":           "dist",
    "paths": {
      "@best-bets/algorithm": ["./packages/algorithm/index.ts"]
    }
  },
  "include": ["packages/**/*", "api/**/*", "apps/**/*"],
  "exclude": ["node_modules", "**/dist"]
}
